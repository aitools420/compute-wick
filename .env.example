# --- runtime ---
PORT=8956
POLL_SECONDS=1800

# --- providers (comma list; a provider with no key still runs and records DOWN honestly; datacrunch and akash need no key at all) ---
PROVIDERS=vast,runpod,datacrunch,akash,cudo,ionet,hyperstack,novita,primeintellect,shadeform
VAST_API_KEY=
RUNPOD_API_KEY=

# --- THE FEE LEVER: 0 = zero platform fees (launch state). Basis points on top of provider price. ---
FEE_BPS=0

# --- referral slots (empty = plain links) ---
REF_VAST=
REF_RUNPOD=

# --- storage (override for Docker/VPS) ---
DB_PATH=

# --- Stage 2 broker (BYO-key rental execution; see BROKER-DESIGN.md). 0 = dark. ---
BROKER_ENABLED=0

# --- tiered polling: the keyed money feeds refresh faster than catalogs ---
FAST_POLL_SECONDS=300
FAST_PROVIDERS=vast,runpod

# --- /receipts: SHA-256 of the house metering account whose ledger is public (empty = page shows its empty state) ---
RECEIPTS_ACCOUNT_HASH=
